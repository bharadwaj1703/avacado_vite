# Production Environment Variables Template
# Copy this file and fill in your actual values in Render Dashboard

# ============================================
# BACKEND ENVIRONMENT VARIABLES
# ============================================

# Server Configuration
NODE_ENV=production
API_PORT=3001

# Database Configuration (Choose one)
DATABASE=turso
# For Turso (Recommended for production):
DATABASE_TURSO_AUTH_TOKEN=your_turso_auth_token_here
DATABASE_TURSO_DATABASE_URL=libsql://your-database.turso.io

# For SQLite (Requires persistent disk):
# DATABASE=sqlite
# SQLITE_DB_PATH=/data/avacado.sqlite

# Clerk Authentication
CLERK_SECRET_KEY=your_clerk_secret_key_here
CLERK_BACKEND_API_URL=https://api.clerk.com
CLERK_WEBHOOK_SECRET=your_clerk_webhook_secret_here

# AI API Keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# AI Model Pricing Limits
AI_MODEL_MAX_INPUT_PRICE_PER_MTOK=1.00
AI_MODEL_MAX_OUTPUT_PRICE_PER_MTOK=2.5

# Text-to-Speech Configuration
TTS_STORAGE=local
TTS_PROVIDER=gemini
TTS_VOICE=Fenrir

# Cloudflare R2 Storage (Optional)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=your_bucket_name
R2_PUBLIC_URL=https://your-bucket-url.com
R2_S3_PUBLIC_URL=https://your-s3-url.r2.cloudflarestorage.com

# CORS Configuration (Optional)
ALLOWED_ORIGINS=https://your-frontend-url.onrender.com,https://your-custom-domain.com

# ============================================
# FRONTEND ENVIRONMENT VARIABLES
# ============================================

# API Configuration
VITE_API_ORIGIN=https://avacado-backend.onrender.com

# Clerk Authentication
VITE_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
CLERK_FRONTEND_API_URL=https://your-clerk-instance.clerk.accounts.dev

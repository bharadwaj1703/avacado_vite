# Backend Environment Variables
# Copy this to .env and fill in your values

# Vercel (for deployment)
VERCEL_OIDC_TOKEN=XXXXX

# Clerk (backend API auth verification)
CLERK_FRONTEND_API_URL=https://
CLERK_SECRET_KEY=YOUR_CLERK_SECRET_KEY
CLERK_BACKEND_API_URL=https://api.clerk.com

# Database Configuration
DATABASE=sqlite
SQLITE_DB_PATH=./.data/avacado.sqlite

# Turso (when DATABASE=turso) — required for prod
# DATABASE_TURSO_DATABASE_URL=libsql://your-db.turso.io
# DATABASE_TURSO_AUTH_TOKEN=your-token

# Cloudflare D1 (when DATABASE=d1)
CLOUDFLARE_ACCOUNT_ID=YOUR_ACCOUNT_ID
CLOUDFLARE_D1_DATABASE_ID=YOUR_D1_DATABASE_ID
CLOUDFLARE_API_TOKEN=YOUR_CLOUDFLARE_API_TOKEN

# TTS Configuration
TTS_STORAGE=local # local = public/tts; r2 = upload to R2
TTS_PROVIDER=gemini
TTS_VOICE=Kore

# Provider API keys (set the one for TTS_PROVIDER)
GEMINI_API_KEY=XXXXX
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# Optional: provider-specific TTS model
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# OPENAI_TTS_MODEL=tts-1
# ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

# Chat (OpenRouter) — required for /api/chat and /api/chat/models
OPENROUTER_API_KEY=your-openrouter-api-key

# Max price per million tokens (USD)
AI_MODEL_MAX_INPUT_PRICE_PER_MTOK=1.00
AI_MODEL_MAX_OUTPUT_PRICE_PER_MTOK=2.5

# R2 (only when TTS_STORAGE=r2)
# CLOUDFLARE_R2_ACCESS_KEY_ID=
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=

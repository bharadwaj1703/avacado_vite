# Frontend Environment Variables
# Copy this to .env and fill in your values

# Clerk (frontend authentication)
VITE_CLERK_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# API Origin (for development)
# Dev: API runs on port 3001. Set this so the app talks to the API directly (avoids proxy).
# Use when you see ERR_CONNECTION_REFUSED for /api/* — run both frontend and backend servers.
# VITE_API_ORIGIN=http://localhost:3001

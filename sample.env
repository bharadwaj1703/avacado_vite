VERCEL_OIDC_TOKEN=XXXXX
VITE_CLERK_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Dev: API runs on port 3001. Set this so the app talks to the API directly (avoids proxy).
# Use when you see ERR_CONNECTION_REFUSED for /api/* — run `bun run dev` so both Vite and API start.
# VITE_API_ORIGIN=http://localhost:3001

# Clerk (backend API auth verification)
CLERK_FRONTEND_API_URL=https://
CLERK_SECRET_KEY=YOUR_CLERK_SECRET_KEY
CLERK_BACKEND_API_URL=https://api.clerk.com



# Turso (when DATABASE=turso) — required for prod
# DATABASE_TURSO_DATABASE_URL=libsql://your-db.turso.io
# DATABASE_TURSO_AUTH_TOKEN=your-token

# Migrations run at build time (bun run build). For local dev without building, run: bun run migrate
# Cloudflare D1 (when DATABASE=d1)
CLOUDFLARE_ACCOUNT_ID=YOUR_ACCOUNT_ID
CLOUDFLARE_D1_DATABASE_ID=YOUR_D1_DATABASE_ID
CLOUDFLARE_API_TOKEN=YOUR_CLOUDFLARE_API_TOKEN

TTS_STORAGE=local # TTS generation (bun run generate): local = public/tts; r2 = upload to R2. Use --force to regenerate all.

TTS_PROVIDER=gemini
TTS_VOICE=Kore

# Provider API keys (set the one for TTS_PROVIDER in .env.local / Vercel)
GEMINI_API_KEY=XXXXX
OPENROUTER_API_KEY=XXXX
# or: GEMINI_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# Optional: provider-specific TTS model (defaults: gemini-2.5-flash-preview-tts, tts-1, eleven_multilingual_v2)
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# OPENAI_TTS_MODEL=tts-1
# ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

# Chat (OpenRouter) — required for /api/chat and /api/chat/models
OPENROUTER_API_KEY=your-openrouter-api-key
# Max price per million tokens (USD). Models with higher input/output price are excluded.
AI_MODEL_MAX_INPUT_PRICE_PER_MTOK=1.00
AI_MODEL_MAX_OUTPUT_PRICE_PER_MTOK=2.5

# R2 (only when TTS_STORAGE=r2) — same account as D1, but use R2 API token
# CLOUDFLARE_ACCOUNT_ID=          # same as D1 (your account ID)
# CLOUDFLARE_R2_ACCESS_KEY_ID=    # R2 API token access key
# CLOUDFLARE_R2_SECRET_ACCESS_KEY= # R2 API token secret
# R2_BUCKET_NAME=                 # bucket name (e.g. avacado-tts)
# R2_PUBLIC_URL=                  # public base URL

DATABASE=sqlite
DATABASE_TURSO_AUTH_TOKEN=XXXX
DATABASE_TURSO_DATABASE_URL=libsql://
SQLITE_DB_PATH=./.data/avacado.sqlite

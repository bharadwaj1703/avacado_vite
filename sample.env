# Clerk (frontend)
VITE_CLERK_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Clerk (backend API auth verification)
CLERK_SECRET_KEY=YOUR_CLERK_SECRET_KEY
CLERK_BACKEND_API_URL=https://api.clerk.com

# Clerk webhook verification (Svix)
CLERK_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Database provider: sqlite for local/test, d1 for staging/prod
DATABASE_PROVIDER=sqlite

# SQLite (local/test)
SQLITE_DB_PATH=./.data/avacado.sqlite

# Cloudflare D1 (staging/prod via Vercel API functions)
CLOUDFLARE_ACCOUNT_ID=YOUR_ACCOUNT_ID
CLOUDFLARE_D1_DATABASE_ID=YOUR_D1_DATABASE_ID
CLOUDFLARE_API_TOKEN=YOUR_CLOUDFLARE_API_TOKEN
